rules_version = '2';

// The orch relay (orch-app docs/PUSH.md). A phone signed in anonymously may create sealed
// messages only in its own mailbox, mailboxes/<its uid>/<machine>/<id>, and read or delete
// only those (delete = undo while still queued). Machines read and delete with the orch-push
// service account, which these rules don't govern. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /mailboxes/{uid}/{machine}/{msg} {
      allow create: if request.auth != null && request.auth.uid == uid
        && machine.size() <= 64
        && request.resource.data.keys().hasOnly(['v', 'nonce', 'ct', 'created'])
        && request.resource.data.keys().hasAll(['v', 'nonce', 'ct', 'created'])
        && request.resource.data.v == '1'
        && request.resource.data.nonce is string && request.resource.data.nonce.size() == 16
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 65536
        && request.resource.data.created == request.time;
      allow get, list, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
